bunx lint-staged
bunx vitest run --changed --reporter=dot

# クイズデータが変更された場合のみ、構造検証とアドバイザリlintを実行する
# 個別スクリプトを直に並べると、検査を足したときにここへの追従が漏れる
# （実際 check-diagram-text がそうなっていた）。npm script 経由に統一する。
if git diff --cached --name-only | grep -q '^src/data/quizzes\.json$'; then
  bun run quiz:check
  bun run quiz:lint:dry
fi
